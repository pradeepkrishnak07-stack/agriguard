# AGRIGUARD Backend Environment Configuration Example

# Optional: OpenWeather API key. If left blank, AGRIGUARD automatically uses Open-Meteo
# agrometeorological service with zero API keys required!
OPENWEATHER_API_KEY=

# Google Gemini agriculture Q&A assistant. Obtain a key from Google AI Studio.
# Configure this only in the backend environment; never use a VITE_ variable.
GEMINI_API_KEY=
# No automatic model fallback is performed if this model is unavailable.
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated HTTPS frontend origins for deployment; blank uses local development origins.
FRONTEND_ORIGINS=

# Default Farm Coordinates (Defaults to Thanjavur, Tamil Nadu)
DEFAULT_LATITUDE=10.7870
DEFAULT_LONGITUDE=79.1378
DEFAULT_LOCATION_NAME=Thanjavur, Tamil Nadu

# Model parameters
MODEL_VERSION=AgriGuard-Vision-v1.4
CONFIDENCE_THRESHOLD=0.55
HIGH_CONFIDENCE_THRESHOLD=0.80
WEATHER_CACHE_MINUTES=30
